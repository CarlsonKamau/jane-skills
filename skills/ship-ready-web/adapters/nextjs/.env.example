# Copy to .env.local and fill in. Never commit .env.local.
# Rule: anything prefixed NEXT_PUBLIC_ ships to the browser. Only put values
# there that are safe for the whole internet to read.

NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-is-ok-here

# Server only. No NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
